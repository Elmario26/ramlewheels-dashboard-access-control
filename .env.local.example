# Copy to .env.local for local XAMPP (optional)

### Free Railway deploy — export local logins (run once on XAMPP):
#   php bin/console app:build-railway-seed
# Then commit data/railway_seed.json and set IMPORT_RAILWAY_SEED=1 on Railway.

### Optional: full DB sync (dev only, needs public MySQL URL)
# RAILWAY_DATABASE_URL="mysql://user:pass@host:port/railway"
# SYNC_SECRET=long-random-string
