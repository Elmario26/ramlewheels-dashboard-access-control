<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sync local DB → Railway</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: system-ui, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
        .warn { background: #fef3c7; border: 1px solid #f59e0b; padding: 1rem; border-radius: 8px; margin: 1rem 0; }
        .ok { background: #d1fae5; border: 1px solid #10b981; padding: 1rem; border-radius: 8px; }
        .err { background: #fee2e2; border: 1px solid #ef4444; padding: 1rem; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #e5e7eb; }
        input[type=text], input[type=password] { width: 100%; padding: 0.5rem; margin: 0.25rem 0 1rem; }
        button { background: #b32224; color: #fff; border: none; padding: 0.75rem 1.5rem; border-radius: 6px; cursor: pointer; }
        code { background: #f3f4f6; padding: 0.15rem 0.35rem; border-radius: 4px; }
    </style>
</head>
<body>
    <h1>Sync local database → Railway</h1>
    <p>Dev-only tool. Run from XAMPP with <code>APP_ENV=dev</code>. This <strong>replaces</strong> all data in the Railway database.</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="{{ label == 'success' ? 'ok' : 'err' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if not configured %}
        <div class="warn">
            <p><strong>RAILWAY_DATABASE_URL</strong> is not set.</p>
            <p>Add to <code>.env.local</code>:</p>
            <pre>RAILWAY_DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/railway
SYNC_SECRET=your-long-secret-here</pre>
            <p>Copy the connection URL from Railway → MySQL service → <strong>Connect</strong> (enable public networking if needed).</p>
        </div>
    {% else %}
        {% if error %}
            <div class="err"><strong>Error:</strong> {{ error }}</div>
        {% endif %}

        {% if result %}
            <div class="ok">
                <p><strong>{{ result.total }}</strong> rows copied.</p>
                <table>
                    <thead><tr><th>Table</th><th>Rows</th></tr></thead>
                    <tbody>
                    {% for table, count in result.tables %}
                        <tr><td>{{ table }}</td><td>{{ count }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="warn">
            <p>This will <strong>truncate and overwrite</strong> these tables on Railway: users, customers, cars, sales, services, documents, bookings, etc.</p>
        </div>

        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('sync_railway') }}">
            <label>Sync secret (<code>SYNC_SECRET</code> from .env.local)</label>
            <input type="password" name="sync_secret" required autocomplete="off">

            <label>
                <input type="checkbox" name="confirm" value="yes" required>
                I understand this will erase Railway data and copy from my local database
            </label>

            <p><button type="submit">Copy local data to Railway</button></p>
        </form>
    {% endif %}

    <p><a href="{{ path('app_dashboard') }}">← Back to dashboard</a></p>
</body>
</html>
