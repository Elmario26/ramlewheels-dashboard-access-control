<div id="toastStack" class="fixed top-20 right-4 z-[100] flex flex-col gap-3 w-full max-w-sm pointer-events-none" aria-live="polite" aria-atomic="true"></div>

<style>
    .toast-item {
        pointer-events: auto;
        transform: translateX(120%);
        opacity: 0;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
    }
    .toast-item.toast-visible {
        transform: translateX(0);
        opacity: 1;
    }
    .toast-item.toast-leaving {
        transform: translateX(120%);
        opacity: 0;
    }
</style>

<script>
(function () {
    const TOAST_META = {
        approved: {
            title: 'Approved',
            ring: 'ring-green-500/30',
            bar: 'bg-green-500',
            iconBg: 'bg-green-500/15',
            icon: '<svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        },
        rejected: {
            title: 'Rejected',
            ring: 'ring-red-500/30',
            bar: 'bg-red-500',
            iconBg: 'bg-red-500/15',
            icon: '<svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        },
        completed: {
            title: 'Completed',
            ring: 'ring-indigo-500/30',
            bar: 'bg-indigo-500',
            iconBg: 'bg-indigo-500/15',
            icon: '<svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>',
        },
        deleted: {
            title: 'Removed',
            ring: 'ring-gray-500/30',
            bar: 'bg-gray-500',
            iconBg: 'bg-gray-500/15',
            icon: '<svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>',
        },
        success: {
            title: 'Success',
            ring: 'ring-green-500/30',
            bar: 'bg-green-500',
            iconBg: 'bg-green-500/15',
            icon: '<svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>',
        },
        warning: {
            title: 'Notice',
            ring: 'ring-amber-500/30',
            bar: 'bg-amber-500',
            iconBg: 'bg-amber-500/15',
            icon: '<svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>',
        },
        error: {
            title: 'Error',
            ring: 'ring-red-500/30',
            bar: 'bg-red-500',
            iconBg: 'bg-red-500/15',
            icon: '<svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        },
        info: {
            title: 'Update',
            ring: 'ring-blue-500/30',
            bar: 'bg-blue-500',
            iconBg: 'bg-blue-500/15',
            icon: '<svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
        },
    };

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    window.showModernToast = function (type, title, message, durationMs) {
        const stack = document.getElementById('toastStack');
        if (!stack) return;

        const meta = TOAST_META[type] || TOAST_META.info;
        const toastTitle = title || meta.title;
        const toastMessage = message || '';
        const duration = Number.isFinite(durationMs) ? durationMs : 5200;

        const toast = document.createElement('div');
        toast.className = `toast-item relative overflow-hidden rounded-xl border border-gray-700/80 bg-gray-900/95 backdrop-blur-md shadow-2xl ring-1 ${meta.ring}`;
        toast.innerHTML = `
            <div class="absolute left-0 top-0 bottom-0 w-1 ${meta.bar}"></div>
            <div class="flex items-start gap-3 p-4 pl-5">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg ${meta.iconBg} flex items-center justify-center">
                    ${meta.icon}
                </div>
                <div class="flex-1 min-w-0 pt-0.5">
                    <p class="text-sm font-semibold text-white">${escapeHtml(toastTitle)}</p>
                    <p class="mt-1 text-sm text-gray-400 leading-snug">${escapeHtml(toastMessage)}</p>
                </div>
                <button type="button" class="toast-close flex-shrink-0 p-1 rounded-lg text-gray-500 hover:text-gray-200 hover:bg-gray-800 transition-colors" aria-label="Dismiss">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="toast-progress absolute bottom-0 left-0 h-0.5 ${meta.bar} w-full origin-left scale-x-100" style="transition: transform ${duration}ms linear;"></div>
        `;

        const dismiss = () => {
            toast.classList.remove('toast-visible');
            toast.classList.add('toast-leaving');
            window.setTimeout(() => toast.remove(), 350);
        };

        toast.querySelector('.toast-close')?.addEventListener('click', dismiss);
        stack.prepend(toast);

        requestAnimationFrame(() => {
            toast.classList.add('toast-visible');
            const bar = toast.querySelector('.toast-progress');
            if (bar) {
                requestAnimationFrame(() => {
                    bar.style.transform = 'scaleX(0)';
                });
            }
        });

        window.setTimeout(dismiss, duration);
    };

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-flash-type][data-flash-message]').forEach(function (el) {
            const type = el.getAttribute('data-flash-type') || 'info';
            const message = el.getAttribute('data-flash-message') || '';
            if (!message) return;

            const meta = TOAST_META[type];
            window.showModernToast(type, meta ? meta.title : null, message);
        });
    });
})();
</script>
