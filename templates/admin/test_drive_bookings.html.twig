{% extends 'base.html.twig' %}

{% block title %}Test Drive Bookings{% endblock %}

{% block body %}
    <div id="bookingsLiveRoot"
         data-live-url="{{ path('app_test_drive_bookings_live') }}"
         data-socket-event="booking.updated"
         data-toast-label="Test drive bookings"
         data-ws-gateway="{{ ws_gateway_url|default('') }}">

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-100">Test Drive Bookings</h1>
            <p class="mt-1 text-sm text-gray-500">Review and manage customer test drive requests</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="bg-gray-800 rounded-xl shadow-lg p-5 border border-gray-700">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-blue-500/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-gray-400 text-sm font-medium">Total</p>
                        <p class="text-2xl font-bold text-white" data-stat="total">{{ totalBookings }}</p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-800 rounded-xl shadow-lg p-5 border border-gray-700">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-amber-500/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-gray-400 text-sm font-medium">Pending</p>
                        <p class="text-2xl font-bold text-white" data-stat="pending">{{ pendingBookings }}</p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-800 rounded-xl shadow-lg p-5 border border-gray-700">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-green-500/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-gray-400 text-sm font-medium">Approved</p>
                        <p class="text-2xl font-bold text-white" data-stat="approved">{{ approvedBookings }}</p>
                    </div>
                </div>
            </div>
            <div class="bg-gray-800 rounded-xl shadow-lg p-5 border border-gray-700">
                <div class="flex items-center">
                    <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-red-500/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-gray-400 text-sm font-medium">Rejected</p>
                        <p class="text-2xl font-bold text-white" data-stat="rejected">{{ rejectedBookings }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-6 flex flex-wrap gap-2">
            {% set filters = {
                'pending': { label: 'Pending', count: pendingBookings, active: 'bg-amber-600/30 border-amber-500 text-amber-200' },
                'approved': { label: 'Approved', count: approvedBookings, active: 'bg-green-600/30 border-green-500 text-green-200' },
                'rejected': { label: 'Rejected', count: rejectedBookings, active: 'bg-red-600/30 border-red-500 text-red-200' },
                'all': { label: 'All', count: totalBookings, active: 'bg-[#B32224]/30 border-[#B32224] text-red-200' }
            } %}
            {% for key, f in filters %}
                <a href="{{ path('app_test_drive_bookings', {status: key}) }}"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border transition-all duration-200
                          {% if currentFilter == key %}{{ f.active }}{% else %}bg-gray-800 border-gray-600 text-gray-400 hover:border-gray-500 hover:text-gray-200{% endif %}">
                    {{ f.label }}
                    <span class="px-2 py-0.5 rounded-full text-xs {% if currentFilter == key %}bg-black/20{% else %}bg-gray-700{% endif %}" data-filter-count="{{ key }}">{{ f.count }}</span>
                </a>
            {% endfor %}
        </div>

        <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
            <div id="bookingsLiveTableWrap" class="overflow-x-auto {% if bookings|length == 0 %}hidden{% endif %}">
                <table class="min-w-full divide-y divide-gray-700">
                    <thead class="bg-gray-900/50">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Customer</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Vehicle</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Requested</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Created</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="bookingsLiveBody" class="divide-y divide-gray-700">
                        {% include 'admin/partials/_test_drive_bookings_rows.html.twig' %}
                    </tbody>
                </table>
            </div>
            <div id="bookingsLiveEmpty" class="py-16 px-6 text-center {% if bookings|length > 0 %}hidden{% endif %}">
                <div class="mx-auto w-16 h-16 rounded-full bg-gray-700 flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-200">No bookings found</h3>
                <p class="mt-1 text-sm text-gray-500">There are no test drive bookings for this filter.</p>
            </div>
        </div>
    </div>

    <div id="approvalModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" onclick="closeApprovalModal()"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-md bg-gray-800 border border-gray-700 rounded-xl shadow-2xl" onclick="event.stopPropagation()">
                <div class="px-6 py-4 border-b border-gray-700 flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Approve Booking
                    </h3>
                    <button type="button" onclick="closeApprovalModal()" class="text-gray-400 hover:text-gray-200 p-1 rounded-lg hover:bg-gray-700" aria-label="Close">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <form id="approvalForm" class="p-6">
                    <input type="hidden" name="_token" id="approvalToken" value="">
                    <input type="hidden" name="bookingId" id="bookingId">
                    <p class="text-sm text-gray-400 mb-1">Customer</p>
                    <p id="customerName" class="text-white font-semibold mb-4"></p>
                    <label for="staffRemarks" class="block text-sm font-medium text-gray-300 mb-2">Staff remarks</label>
                    <textarea name="staffRemarks" id="staffRemarks" rows="4"
                              class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-[#B32224] focus:border-transparent resize-none"
                              placeholder="e.g. Test drive scheduled Saturday 10 AM. Arrive 15 minutes early."></textarea>
                    <div class="mt-6 flex justify-end gap-3">
                        <button type="button" onclick="closeApprovalModal()"
                                class="px-4 py-2.5 rounded-lg bg-gray-700 text-gray-300 hover:bg-gray-600 transition-colors">
                            Cancel
                        </button>
                        <button type="submit"
                                class="px-4 py-2.5 rounded-lg bg-green-600 text-white hover:bg-green-700 flex items-center gap-2 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            Approve
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    function showApprovalModal(bookingId, customerName, token) {
        document.getElementById('bookingId').value = bookingId;
        document.getElementById('approvalToken').value = token;
        document.getElementById('customerName').textContent = customerName;
        document.getElementById('staffRemarks').value = '';
        document.getElementById('approvalModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeApprovalModal() {
        document.getElementById('approvalModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.getElementById('approvalForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const bookingId = document.getElementById('bookingId').value;
        const remarks = document.getElementById('staffRemarks').value;
        const token = document.getElementById('approvalToken').value;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/test-drive-bookings/' + bookingId + '/approve';
        form.innerHTML = `
            <input type="hidden" name="_token" value="${token}">
            <input type="hidden" name="staffRemarks" value="${remarks.replace(/"/g, '&quot;')}">
        `;
        document.body.appendChild(form);
        form.submit();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeApprovalModal();
    });
    </script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'admin/partials/_bookings_live_script.html.twig' %}
{% endblock %}
