{% for booking in bookings %}
    <tr class="hover:bg-gray-700/40 transition-colors duration-150" data-booking-id="{{ booking.id }}">
        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-[#B32224]">#{{ booking.id }}</td>
        <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-100">{{ booking.customer.firstName }} {{ booking.customer.lastName }}</div>
            <div class="text-xs text-gray-500">{{ booking.phone }}</div>
        </td>
        <td class="px-6 py-4">
            <div class="text-sm font-medium text-gray-100">{{ booking.serviceName }}</div>
            <div class="text-xs text-gray-500">{{ booking.vehicleDescription }}</div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
            {{ booking.requestedDateTime|date('M d, Y') }}
            <span class="text-gray-500">{{ booking.requestedDateTime|date('g:i A') }}</span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                {% if booking.status == 'pending' %}bg-amber-500/20 text-amber-300 border border-amber-500/40
                {% elseif booking.status == 'approved' %}bg-green-500/20 text-green-300 border border-green-500/40
                {% elseif booking.status == 'rejected' %}bg-red-500/20 text-red-300 border border-red-500/40
                {% else %}bg-indigo-500/20 text-indigo-300 border border-indigo-500/40{% endif %}">
                {{ booking.status|capitalize }}
            </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="flex items-center justify-end gap-2">
                <a href="{{ path('app_service_booking_view', {id: booking.id}) }}"
                   class="px-2 py-1 rounded bg-gray-700 text-gray-200 hover:bg-gray-600 text-xs">View</a>
                {% if booking.status == 'pending' %}
                    <form method="post" action="{{ path('app_service_booking_approve', {id: booking.id}) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ booking.id) }}">
                        <button type="submit" class="px-2 py-1 rounded bg-green-600 text-white hover:bg-green-700 text-xs">Approve</button>
                    </form>
                    <form method="post" action="{{ path('app_service_booking_reject', {id: booking.id}) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ booking.id) }}">
                        <button type="submit" class="px-2 py-1 rounded bg-red-600 text-white hover:bg-red-700 text-xs">Reject</button>
                    </form>
                {% elseif booking.status == 'approved' %}
                    <form method="post" action="{{ path('app_service_booking_complete', {id: booking.id}) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ booking.id) }}">
                        <button type="submit" class="px-2 py-1 rounded bg-indigo-600 text-white hover:bg-indigo-700 text-xs">Complete</button>
                    </form>
                {% endif %}
            </div>
        </td>
    </tr>
{% endfor %}
