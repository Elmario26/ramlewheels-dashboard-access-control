{% extends 'base.html.twig' %}

{% block title %}Test Drive Booking #{{ booking.id }}{% endblock %}

{% block body %}
    {% set carImage = booking.car.images is not empty ? booking.car.images|first : null %}

    <!-- Header -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-100">Booking #{{ booking.id }}</h1>
                <p class="mt-1 text-gray-400">Test drive request details and actions</p>
            </div>
            <a href="{{ path('app_test_drive_bookings', {status: booking.status}) }}"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gray-700 hover:bg-gray-600 text-white font-medium transition-colors shadow-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Back to Bookings
            </a>
        </div>
    </div>

    <!-- Status timeline -->
    <div class="mb-8 bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-700">
            <h2 class="text-lg font-semibold text-white">Booking progress</h2>
        </div>
        <div class="p-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                <div class="flex items-center gap-4 flex-1">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0
                        {% if booking.status in ['pending','approved','rejected','completed'] %}bg-blue-500{% else %}bg-gray-600{% endif %}">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-white">Submitted</p>
                        <p class="text-xs text-gray-500">{{ booking.createdAt|date('M d, Y · g:i A') }}</p>
                    </div>
                </div>
                <div class="hidden sm:block flex-1 h-0.5 bg-gray-600 mx-2"></div>
                <div class="flex items-center gap-4 flex-1">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0
                        {% if booking.status == 'pending' %}bg-amber-500 ring-4 ring-amber-500/30
                        {% elseif booking.status in ['approved','completed'] %}bg-green-500
                        {% elseif booking.status == 'rejected' %}bg-red-500
                        {% else %}bg-gray-600{% endif %}">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium {% if booking.status == 'pending' %}text-amber-300{% else %}text-white{% endif %}">Review</p>
                        <p class="text-xs text-gray-500">
                            {% if booking.status == 'pending' %}Awaiting staff{% else %}{{ booking.status|capitalize }}{% endif %}
                        </p>
                    </div>
                </div>
                <div class="hidden sm:block flex-1 h-0.5 bg-gray-600 mx-2"></div>
                <div class="flex items-center gap-4 flex-1">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0
                        {% if booking.status == 'completed' %}bg-blue-500{% else %}bg-gray-600{% endif %}">
                        <svg class="w-6 h-6 {% if booking.status == 'completed' %}text-white{% else %}text-gray-400{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium {% if booking.status == 'completed' %}text-blue-300{% else %}text-gray-500{% endif %}">Completed</p>
                        <p class="text-xs text-gray-500">Test drive done</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main column -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Summary card -->
            <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
                <div class="bg-gradient-to-r from-gray-900 to-gray-800 px-6 py-5 border-b border-gray-700 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-xl bg-[#B32224]/20 border border-[#B32224]/40 flex items-center justify-center">
                            <svg class="w-7 h-7 text-[#B32224]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-gray-400 text-sm">Scheduled test drive</p>
                            <p class="text-xl font-bold text-white">{{ booking.requestedDateTime|date('l, F j, Y') }}</p>
                            <p class="text-[#B32224] font-semibold">{{ booking.requestedDateTime|date('g:i A') }}</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold border
                        {% if booking.status == 'pending' %}bg-amber-500/20 text-amber-300 border-amber-500/40
                        {% elseif booking.status == 'approved' %}bg-green-500/20 text-green-300 border-green-500/40
                        {% elseif booking.status == 'rejected' %}bg-red-500/20 text-red-300 border-red-500/40
                        {% else %}bg-blue-500/20 text-blue-300 border-blue-500/40{% endif %}">
                        {{ booking.status|capitalize }}
                    </span>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3 p-4 bg-gray-700/50 rounded-lg">
                        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Created</p>
                            <p class="text-white font-medium">{{ booking.createdAt|date('M d, Y · g:i A') }}</p>
                        </div>
                    </div>
                    {% if booking.updatedAt %}
                    <div class="flex items-center gap-3 p-4 bg-gray-700/50 rounded-lg">
                        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wide">Last updated</p>
                            <p class="text-white font-medium">{{ booking.updatedAt|date('M d, Y · g:i A') }}</p>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Customer -->
            <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700">
                    <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#B32224]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        Customer
                    </h2>
                </div>
                <div class="p-6">
                    <div class="flex items-start gap-4 mb-6">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-[#B32224] to-red-800 flex items-center justify-center text-white text-xl font-bold shrink-0">
                            {{ booking.customer.firstName|first|upper }}{{ booking.customer.lastName|first|upper }}
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white">{{ booking.customer.firstName }} {{ booking.customer.lastName }}</h3>
                            <span class="inline-flex mt-1 px-2.5 py-0.5 rounded text-xs font-medium bg-blue-500/20 text-blue-300 border border-blue-500/30">Customer</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg">
                            <svg class="w-5 h-5 text-[#B32224] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            <div class="min-w-0">
                                <p class="text-xs text-gray-500">Email</p>
                                <p class="text-white truncate">{{ booking.customer.email }}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-gray-700 rounded-lg">
                            <svg class="w-5 h-5 text-[#B32224] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            <div>
                                <p class="text-xs text-gray-500">Phone</p>
                                <p class="text-white">{% if booking.customer.phone %}+63 {{ booking.customer.phone }}{% else %}Not provided{% endif %}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vehicle -->
            <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700">
                    <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#B32224]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                        </svg>
                        Vehicle
                    </h2>
                </div>
                <div class="p-6">
                    <div class="flex flex-col sm:flex-row gap-6">
                        <div class="sm:w-48 shrink-0">
                            {% if carImage %}
                                <img src="{{ path('serve_car_image', {file: carImage}) }}"
                                     alt="{{ booking.car.brand }} {{ booking.car.make }}"
                                     class="w-full h-36 sm:h-40 object-cover rounded-xl border border-gray-600">
                            {% else %}
                                <div class="w-full h-36 sm:h-40 rounded-xl bg-gray-700 border border-gray-600 flex items-center justify-center">
                                    <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                            {% endif %}
                        </div>
                        <div class="flex-1 grid grid-cols-2 gap-3">
                            <div class="p-3 bg-gray-700/50 rounded-lg">
                                <p class="text-xs text-gray-500">Brand / Model</p>
                                <p class="text-white font-semibold">{{ booking.car.brand }} {{ booking.car.make }}</p>
                            </div>
                            <div class="p-3 bg-gray-700/50 rounded-lg">
                                <p class="text-xs text-gray-500">Year</p>
                                <p class="text-white font-semibold">{{ booking.car.year }}</p>
                            </div>
                            <div class="p-3 bg-gray-700/50 rounded-lg">
                                <p class="text-xs text-gray-500">Color</p>
                                <p class="text-white font-semibold">{{ booking.car.color }}</p>
                            </div>
                            <div class="p-3 bg-gray-700/50 rounded-lg">
                                <p class="text-xs text-gray-500">Price</p>
                                <p class="text-[#B32224] font-bold">₱{{ booking.car.price|number_format(2) }}</p>
                            </div>
                            <div class="p-3 bg-gray-700/50 rounded-lg col-span-2">
                                <p class="text-xs text-gray-500">Inventory status</p>
                                <p class="text-white font-semibold capitalize">{{ booking.car.status }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if booking.notes %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700">
                    <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#B32224]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                        </svg>
                        Customer notes
                    </h2>
                </div>
                <div class="p-6">
                    <p class="text-gray-300 leading-relaxed">{{ booking.notes }}</p>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Sidebar actions -->
        <div class="lg:col-span-1 space-y-6">
            {% if booking.status == 'pending' %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-amber-500/30 overflow-hidden">
                <div class="px-6 py-4 bg-amber-500/10 border-b border-gray-700">
                    <h3 class="text-lg font-semibold text-amber-200 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        Action required
                    </h3>
                    <p class="text-sm text-gray-400 mt-1">Review this request and approve or reject.</p>
                </div>
                <div class="p-6 flex flex-col gap-3">
                    <button type="button" onclick="showApprovalModal()"
                            class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-green-600 hover:bg-green-700 text-white font-medium transition-colors"
                            title="Approve booking">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Approve
                    </button>
                    <button type="button" onclick="showRejectModal()"
                            class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-red-600/90 hover:bg-red-700 text-white font-medium transition-colors"
                            title="Reject booking">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Reject
                    </button>
                </div>
            </div>

            {% elseif booking.status == 'approved' %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-green-500/30 overflow-hidden">
                <div class="px-6 py-4 bg-green-500/10 border-b border-gray-700">
                    <h3 class="text-lg font-semibold text-green-300 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Approved
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    {% if booking.approvedAt %}
                    <div>
                        <p class="text-xs text-gray-500 uppercase">Approved on</p>
                        <p class="text-white font-medium">{{ booking.approvedAt|date('M d, Y · g:i A') }}</p>
                    </div>
                    {% endif %}
                    {% if booking.approvedBy %}
                    <div>
                        <p class="text-xs text-gray-500 uppercase">Approved by</p>
                        <p class="text-white font-medium">{{ booking.approvedBy.firstName }} {{ booking.approvedBy.lastName }}</p>
                        <p class="text-sm text-gray-500">{{ booking.approvedBy.email }}</p>
                    </div>
                    {% endif %}
                    <form method="POST" action="{{ path('app_test_drive_booking_complete', {id: booking.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ booking.id) }}">
                        <button type="submit"
                                class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
                                title="Mark as completed">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            Mark completed
                        </button>
                    </form>
                </div>
            </div>

            {% elseif booking.status == 'rejected' %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-red-500/30 overflow-hidden">
                <div class="px-6 py-4 bg-red-500/10 border-b border-gray-700">
                    <h3 class="text-lg font-semibold text-red-300 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Rejected
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    {% if booking.approvedAt %}
                    <div>
                        <p class="text-xs text-gray-500 uppercase">Rejected on</p>
                        <p class="text-white font-medium">{{ booking.approvedAt|date('M d, Y · g:i A') }}</p>
                    </div>
                    {% endif %}
                    {% if booking.approvedBy %}
                    <div>
                        <p class="text-xs text-gray-500 uppercase">Rejected by</p>
                        <p class="text-white font-medium">{{ booking.approvedBy.firstName }} {{ booking.approvedBy.lastName }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% elseif booking.status == 'completed' %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-blue-500/30 overflow-hidden">
                <div class="px-6 py-4 bg-blue-500/10 border-b border-gray-700 text-center">
                    <div class="w-14 h-14 mx-auto rounded-full bg-blue-500 flex items-center justify-center mb-3">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-blue-300">Test drive completed</h3>
                    <p class="text-sm text-gray-500 mt-1">This booking is closed.</p>
                </div>
            </div>
            {% endif %}

            {% if booking.staffRemarks %}
            <div class="bg-gray-800 rounded-xl shadow-lg border border-gray-700 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700">
                    <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-[#B32224]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Staff remarks
                    </h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-300 leading-relaxed">{{ booking.staffRemarks }}</p>
                </div>
            </div>
            {% endif %}
        </div>
    </div>

<!-- Approve Modal -->
<div id="approvalModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" onclick="closeApprovalModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-gray-800 border border-gray-700 rounded-xl shadow-2xl" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-700 flex items-center justify-between">
                <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Approve booking
                </h3>
                <button type="button" onclick="closeApprovalModal()" class="p-1 rounded-lg text-gray-400 hover:text-white hover:bg-gray-700" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <form method="POST" action="{{ path('app_test_drive_booking_approve', {id: booking.id}) }}" class="p-6">
                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ booking.id) }}">
                <p class="text-sm text-gray-400">Customer</p>
                <p class="text-white font-semibold mb-4">{{ booking.customer.firstName }} {{ booking.customer.lastName }}</p>
                <label for="staffRemarks" class="block text-sm font-medium text-gray-300 mb-2">Staff remarks</label>
                <textarea name="staffRemarks" id="staffRemarks" rows="4"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-[#B32224] focus:border-transparent resize-none"
                          placeholder="Schedule details for the customer..."></textarea>
                <div class="mt-6 flex justify-end gap-3">
                    <button type="button" onclick="closeApprovalModal()" class="px-4 py-2.5 rounded-lg bg-gray-700 text-gray-300 hover:bg-gray-600">Cancel</button>
                    <button type="submit" class="px-4 py-2.5 rounded-lg bg-green-600 text-white hover:bg-green-700 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Approve
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" onclick="closeRejectModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-gray-800 border border-gray-700 rounded-xl shadow-2xl" onclick="event.stopPropagation()">
            <div class="px-6 py-4 border-b border-gray-700 flex items-center justify-between">
                <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Reject booking
                </h3>
                <button type="button" onclick="closeRejectModal()" class="p-1 rounded-lg text-gray-400 hover:text-white hover:bg-gray-700" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <form method="POST" action="{{ path('app_test_drive_booking_reject', {id: booking.id}) }}" class="p-6">
                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ booking.id) }}">
                <p class="text-sm text-gray-400 mb-4">Optionally explain why this request was declined.</p>
                <label for="rejectRemarks" class="block text-sm font-medium text-gray-300 mb-2">Staff remarks</label>
                <textarea name="staffRemarks" id="rejectRemarks" rows="4"
                          class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-gray-100 placeholder-gray-500 focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"
                          placeholder="e.g. Vehicle unavailable on requested date."></textarea>
                <div class="mt-6 flex justify-end gap-3">
                    <button type="button" onclick="closeRejectModal()" class="px-4 py-2.5 rounded-lg bg-gray-700 text-gray-300 hover:bg-gray-600">Cancel</button>
                    <button type="submit" class="px-4 py-2.5 rounded-lg bg-red-600 text-white hover:bg-red-700 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        Reject
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showApprovalModal() {
    document.getElementById('staffRemarks').value = '';
    document.getElementById('approvalModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}
function closeApprovalModal() {
    document.getElementById('approvalModal').classList.add('hidden');
    document.body.style.overflow = '';
}
function showRejectModal() {
    document.getElementById('rejectRemarks').value = '';
    document.getElementById('rejectModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}
function closeRejectModal() {
    document.getElementById('rejectModal').classList.add('hidden');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeApprovalModal();
        closeRejectModal();
    }
});
</script>
{% endblock %}
