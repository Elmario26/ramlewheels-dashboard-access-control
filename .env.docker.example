# Copy to .env before: docker compose up -d --build
# cp .env.docker.example .env

APP_ENV=prod
APP_DEBUG=0
# Required — generate: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_this_to_a_random_32_char_string

MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=mydbramlewheels
MYSQL_USER=ramlewheels
MYSQL_PASSWORD=change_db_password

APP_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# Used only when running Symfony on the host (XAMPP). Docker overrides this in compose.
# DATABASE_URL="mysql://ramlewheels:change_db_password@127.0.0.1:3306/mydbramlewheels?serverVersion=8.0.32&charset=utf8mb4"

# --- Railway (app service Variables tab) ---
# Link MySQL to the app, then add (replace "MySQL" with your database service name):
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
# Required:
#   APP_SECRET=<random 32+ char string>
#   DEFAULT_URI=https://your-app.up.railway.app
# Option A — first admin only (quickest):
#   ADMIN_EMAIL=you@example.com
#   ADMIN_PASSWORD=your-secure-password
#   ADMIN_USERNAME=admin
#
# Option B — copy local logins (free): on XAMPP run
#   php bin/console app:build-railway-seed
# commit data/railway_seed.json, then on Railway:
#   IMPORT_RAILWAY_SEED=1
# (remove after first successful deploy)
# Optional Google login:
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=

DEFAULT_URI=http://localhost:8000

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
BREVO_API_KEY=
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Android OAuth client ID (from google-services.json). Optional; used to validate mobile idToken azp.
GOOGLE_ANDROID_CLIENT_ID=
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

# Realtime socket gateway
WS_GATEWAY_URL=http://host.docker.internal:4000
WS_INTERNAL_TOKEN=change-this-to-a-random-secret
