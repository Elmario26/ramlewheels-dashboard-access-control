# Copy to .env before: docker compose up -d --build
# cp .env.docker.example .env

APP_ENV=prod
APP_DEBUG=0
# Required — generate: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_this_to_a_random_32_char_string

MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=mydbramlewheels
MYSQL_USER=ramlewheels
MYSQL_PASSWORD=change_db_password

APP_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# Used only when running Symfony on the host (XAMPP). Docker overrides this in compose.
# DATABASE_URL="mysql://ramlewheels:change_db_password@127.0.0.1:3306/mydbramlewheels?serverVersion=8.0.32&charset=utf8mb4"

DEFAULT_URI=http://localhost:8000

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
BREVO_API_KEY=
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
