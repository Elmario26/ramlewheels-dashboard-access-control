# Minimal .env for Docker/Railway — secrets are injected at runtime when set.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_set_APP_SECRET_on_railway

###> lexik/jwt-authentication-bundle ###
# entrypoint.sh generates config/jwt/*.pem on first boot if missing
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEFAULT_URI=https://ramlewheels-dashboard-access-control-production.up.railway.app
